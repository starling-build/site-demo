{"document":{"addsParagraphSpacing":false,"adjustsLineHeightInTable":false,"backgroundRels":[],"balancesSpaceWidth":false,"compatibilityMode":15,"defaultLangXML":"<w:lang w:val=\"en-US\"/>","defaultTabStop":36,"divMargins":{},"docGridXML":"<w:docGrid w:linePitch=\"360\"/>","endnoteSeparator":[],"endnotes":{},"evenAndOddHeaders":false,"fileFonts":["Arial","Courier New"],"flipsMirrorIndents":true,"footer":"Page {PAGE} of {NUMPAGES}","footnoteSeparator":[],"footnotes":{},"hangsHalf":false,"header":"Starling Desktop  ·  User manual","headerFooters":[{"kind":0,"paragraphs":[{"bookmarks":[],"id":0,"inlineImages":{},"runs":[{"length":32,"style":{}}],"style":{"alignment":2,"borders":{"bottom":{"color":4291876834,"space":4,"width":0.5}},"lineSpacing":1.15,"named":"Header","spaceAfter":0},"text":"Starling Desktop  ·  User manual"}],"section":0,"type":"default"},{"kind":1,"paragraphs":[{"bookmarks":[],"id":0,"inlineImages":{},"runs":[{"length":5,"style":{}},{"length":1,"style":{"field":"PAGE","fieldResult":1}},{"length":4,"style":{}},{"length":1,"style":{"field":"NUMPAGES","fieldResult":2}}],"style":{"alignment":1,"lineSpacing":1.15,"named":"Footer","spaceAfter":0},"text":"Page 1 of 1"}],"section":0,"type":"default"}],"htmlAutoSpacing":true,"indentNotNumberingTabStop":false,"keptCharacterStyleIds":{"hyperlink":"Hyperlink"},"keptCharacterStyles":{"Hyperlink":"<w:style w:styleId=\"Hyperlink\" w:type=\"character\"><w:name w:val=\"Hyperlink\"/><w:qFormat/><w:pPr/><w:rPr><w:color w:val=\"2F5496\"/><w:u w:val=\"single\"/></w:rPr></w:style>"},"keptCompat":"<w:compat><w:compatSetting w:name=\"compatibilityMode\" w:uri=\"http://schemas.microsoft.com/office/word\" w:val=\"15\"/></w:compat>","keptHeaderFooters":[{"kind":0,"part":"word/header1.xml","text":"Starling Desktop  ·  User manual","type":"default"},{"kind":1,"part":"word/footer1.xml","text":"Page {PAGE} of {NUMPAGES}","type":"default"}],"keptPartTypes":{"word/footer1.xml":"application/vnd.openxmlformats-officedocument.wordprocessingml.footer+xml","word/header1.xml":"application/vnd.openxmlformats-officedocument.wordprocessingml.header+xml"},"keptParts":{"word/footer1.xml":"","word/header1.xml":""},"keptSettings":{},"keptTables":{},"kernsPunctuation":true,"listCounterOf":{},"listFormats":{},"listRestarts":{},"paragraphs":[{"bookmarks":[],"id":775482864,"inlineImages":{},"runs":[{"length":37,"style":{}}],"style":{"heading":1},"text":"Workspaces — a desktop for your agent"},{"bookmarks":[],"id":1058185989,"inlineImages":{},"runs":[{"length":8,"style":{"bold":true}},{"length":7,"style":{}},{"length":14,"style":{"bold":true}},{"length":111,"style":{}},{"length":6,"style":{"bold":true}},{"length":68,"style":{}},{"length":3,"style":{"bold":true}},{"length":39,"style":{}},{"length":8,"style":{"bold":true}},{"length":11,"style":{}},{"length":9,"style":{"bold":true}},{"length":139,"style":{}}],"style":{},"text":"Ctrl + ↓ opens workspace mode — a room where one app drives and everything it opens stays beside it. The workspace list is on the left, the driver runs down the middle, and every window the driver opens lands as a tab on the right — never on your desktop. Ctrl + ↓ again (or Workspace in the desktop menu) steps back out to the desktop you came from; the workspace and its apps keep running, and the same key leads back in."},{"bookmarks":[],"id":1567211529,"inlineImages":{},"runs":[{"length":442,"style":{}},{"length":14,"style":{"link":"https://starling.build/#agents"}},{"length":1,"style":{}}],"style":{},"text":"It is built for handing work to an AI agent — coding is the demo, not the boundary: start a terminal as the driver, run an agent in it, and whatever the agent opens to do its job — browsers, editors, documents — stacks up as tabs in its room while your own windows never move. You can watch, and you can step in — click into any pane and use it like any other window. There is a three-minute recording of a coding agent doing exactly this on starling.build."},{"bookmarks":[],"id":604459516,"inlineImages":{},"runs":[{"length":17,"style":{}}],"style":{},"text":"Working the room:"},{"bookmarks":[],"id":986612719,"inlineImages":{},"runs":[{"length":5,"style":{"bold":true}},{"length":96,"style":{}},{"length":5,"style":{"bold":true}},{"length":2,"style":{}},{"length":3,"style":{"bold":true}},{"length":44,"style":{}},{"length":6,"style":{"bold":true}},{"length":56,"style":{}}],"style":{"list":0},"text":"+ New (top of the list) creates a workspace and opens its name for editing in place — type and press Enter (Esc keeps the old name). Rename later from the pencil on the row you are pointing at, or right-click the row."},{"bookmarks":[],"id":928911696,"inlineImages":{},"runs":[{"length":25,"style":{}},{"length":24,"style":{"bold":true}},{"length":19,"style":{}}],"style":{"list":0},"text":"An empty workspace shows Choose an app to work in — pick the driver."},{"bookmarks":[],"id":1798486952,"inlineImages":{},"runs":[{"length":69,"style":{}}],"style":{"list":0},"text":"Drag the divider between the driver and the tabs to change the split."},{"bookmarks":[],"id":541137297,"inlineImages":{},"runs":[{"length":21,"style":{}},{"length":15,"style":{"bold":true}},{"length":33,"style":{}},{"length":5,"style":{"bold":true}},{"length":4,"style":{}}],"style":{"list":0},"text":"Right-click a tab to Move to Desktop (the window leaves the room) or Close it."},{"bookmarks":[],"id":1077237346,"inlineImages":{},"runs":[{"length":4,"style":{}},{"length":5,"style":{"bold":true}},{"length":86,"style":{}},{"length":6,"style":{"bold":true}},{"length":66,"style":{}},{"length":6,"style":{"bold":true}},{"length":137,"style":{}}],"style":{"list":0},"text":"The trash on a hovered row opens the same menu as a right-click, which holds the two ways out: Remove moves the workspace's windows to your desktop and drops the row; Delete stops every app in it. Both sit behind the menu on purpose — a stray click on a hover button must not be able to stop your agent's apps."},{"bookmarks":[],"id":1562733236,"inlineImages":{},"runs":[{"length":41,"style":{}},{"length":8,"style":{"bold":true}},{"length":67,"style":{}}],"style":{"list":0},"text":"Each monitor has its own workspace mode: Ctrl + ↓ acts on the monitor the pointer is on and leaves the others alone."}],"readFromFile":false,"styleAliases":{},"styles":{"styles":[{"char":{"color":4280230696,"complexFontFamily":"Arial","fontFamily":"Arial","fontSize":11,"keptXML":"<w:lang w:val=\"en-US\"/>"},"id":"Normal","name":"Normal","paragraph":{"lineSpacing":1.15}},{"char":{"bold":true,"color":4280232516,"fontSize":36,"letterSpacing":-0.5},"id":"Title","name":"Title","next":"Normal","paragraph":{"contextualSpacing":true,"lineSpacing":1.15,"spaceAfter":6,"spaceBefore":120}},{"char":{"color":4285231744,"fontSize":16},"id":"Subtitle","name":"Subtitle","next":"Normal","paragraph":{"lineSpacing":1.15,"spaceAfter":24}},{"char":{"bold":true,"color":4280232516,"fontSize":20},"id":"Heading1","name":"Heading 1","next":"Normal","paragraph":{"borders":{"bottom":{"color":4291876834,"space":4,"width":0.75}},"heading":1,"keepLines":true,"keepNext":true,"lineSpacing":1.15,"spaceBefore":24}},{"char":{"bold":true,"color":4281291926,"fontSize":14},"id":"Heading2","name":"Heading 2","next":"Normal","paragraph":{"heading":2,"keepLines":true,"keepNext":true,"lineSpacing":1.15,"spaceAfter":6,"spaceBefore":18}},{"char":{"bold":true,"color":4280230696,"fontSize":12},"id":"Heading3","name":"Heading 3","next":"Normal","paragraph":{"heading":3,"keepLines":true,"keepNext":true,"lineSpacing":1.15,"spaceAfter":4,"spaceBefore":12}},{"char":{"bold":true,"color":4281291926,"fontSize":12,"italic":true},"id":"Heading4","name":"Heading 4","next":"Normal","paragraph":{"heading":4,"spaceAfter":2,"spaceBefore":4}},{"char":{"color":4281291926,"fontSize":11},"id":"Heading5","name":"Heading 5","next":"Normal","paragraph":{"heading":5,"spaceAfter":2,"spaceBefore":4}},{"char":{"color":4281291926,"fontSize":11,"italic":true},"id":"Heading6","name":"Heading 6","ne