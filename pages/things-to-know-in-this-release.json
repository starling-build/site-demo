{"document":{"addsParagraphSpacing":false,"adjustsLineHeightInTable":false,"backgroundRels":[],"balancesSpaceWidth":false,"compatibilityMode":15,"defaultLangXML":"<w:lang w:val=\"en-US\"/>","defaultTabStop":36,"divMargins":{},"docGridXML":"<w:docGrid w:linePitch=\"360\"/>","endnoteSeparator":[],"endnotes":{},"evenAndOddHeaders":false,"fileFonts":["Libre Franklin","Caladea","Liberation Mono"],"flipsMirrorIndents":true,"footer":"Page {PAGE} of {NUMPAGES}","footnoteSeparator":[],"footnotes":{},"hangsHalf":false,"header":"Starling Desktop  ·  User manual","headerFooters":[{"kind":0,"paragraphs":[{"bookmarks":[],"id":0,"inlineImages":{},"runs":[{"length":32,"style":{}}],"style":{"alignment":2,"borders":{"bottom":{"color":4291876834,"space":4,"width":0.5}},"lineSpacing":1.1708333333333334,"named":"Header","spaceAfter":0},"text":"Starling Desktop  ·  User manual"}],"section":0,"type":"default"},{"kind":1,"paragraphs":[{"bookmarks":[],"id":0,"inlineImages":{},"runs":[{"length":5,"style":{}},{"length":1,"style":{"field":"PAGE","fieldResult":1}},{"length":4,"style":{}},{"length":1,"style":{"field":"NUMPAGES","fieldResult":2}}],"style":{"alignment":1,"lineSpacing":1.1708333333333334,"named":"Footer","spaceAfter":0},"text":"Page 1 of 1"}],"section":0,"type":"default"}],"htmlAutoSpacing":true,"indentNotNumberingTabStop":false,"keptCharacterStyleIds":{"hyperlink":"Hyperlink"},"keptCharacterStyles":{"Hyperlink":"<w:style w:styleId=\"Hyperlink\" w:type=\"character\"><w:name w:val=\"Hyperlink\"/><w:qFormat/><w:pPr/><w:rPr><w:color w:val=\"C8102E\"/><w:u w:val=\"single\"/></w:rPr></w:style>"},"keptCompat":"<w:compat><w:compatSetting w:name=\"compatibilityMode\" w:uri=\"http://schemas.microsoft.com/office/word\" w:val=\"15\"/></w:compat>","keptHeaderFooters":[{"kind":0,"part":"word/header1.xml","text":"Starling Desktop  ·  User manual","type":"default"},{"kind":1,"part":"word/footer1.xml","text":"Page {PAGE} of {NUMPAGES}","type":"default"}],"keptPartTypes":{"word/footer1.xml":"application/vnd.openxmlformats-officedocument.wordprocessingml.footer+xml","word/header1.xml":"application/vnd.openxmlformats-officedocument.wordprocessingml.header+xml"},"keptParts":{"word/footer1.xml":"","word/header1.xml":""},"keptSettings":{},"keptTables":{},"kernsPunctuation":true,"listCounterOf":{},"listFormats":{},"listRestarts":{},"paragraphs":[{"bookmarks":[],"id":1353810291,"inlineImages":{},"runs":[{"length":30,"style":{}}],"style":{"borders":{"bottom":{"color":4291301422,"space":6,"width":1.5}},"heading":1,"keepLines":true,"keepNext":true,"lineSpacing":1.1708333333333334,"spaceAfter":10,"spaceBefore":28},"text":"Things to know in this release"},{"bookmarks":[],"id":502042458,"inlineImages":{},"runs":[{"length":68,"style":{}}],"style":{},"text":"Starling is an early preview (v0.4.0). A few limits you will notice:"},{"bookmarks":[],"id":138146297,"inlineImages":{},"runs":[{"length":15,"style":{"bold":true}},{"length":165,"style":{}}],"style":{"list":0},"text":"No screen lock. There is a screensaver (below), but it is decoration: any key or mouse movement dismisses it, with nothing asked. Do not rely on it to secure an unattended machine."},{"bookmarks":[],"id":1336828639,"inlineImages":{},"runs":[{"length":30,"style":{"bold":true}},{"length":330,"style":{}}],"style":{"list":0},"text":"Every display scales the same. The session picks one scale for the whole desktop, from the primary panel's pixel density, and Settings → Displays moves it in 0.25 steps (fractional scales included — 1.25 and 1.5 render as crisply as 2.0). A second monitor of a different density therefore shares the first one's scale; per-display scale is not implemented yet."},{"bookmarks":[],"id":12559062,"inlineImages":{},"runs":[{"length":54,"style":{"bold":true}},{"length":133,"style":{}}],"style":{"list":0},"text":"Changing the scale does not rescale apps already open. The desktop and Starling's own apps follow immediately; a third-party Wayland app keeps the size it started at until you restart it."},{"bookmarks":[],"id":329177969,"inlineImages":{},"runs":[{"length":23,"style":{"bold":true}},{"length":49,"style":{}}],"style":{"list":0},"text":"No display-mode picker. The session uses the connector's preferred mode."},{"bookmarks":[],"id":434808130,"inlineImages":{},"runs":[{"length":24,"style":{"bold":true}},{"length":23,"style":{}},{"length":24,"style":{"fontFamily":"Liberation Mono"}},{"length":28,"style":{}},{"length":5,"style":{"fontFamily":"Liberation Mono"}},{"length":89,"style":{}},{"length":15,"style":{"bold":true}},{"length":16,"style":{"bold":true,"fontFamily":"Liberation Mono"}},{"length":10,"style":{"bold":true}},{"length":115,"style":{}}],"style":{"list":0},"text":"Zoom runs without audio. It starts and reports no pactl and pacmd found. That message is expected: pactl is deliberately left off the system because Zoom crashes at startup when it is present. Do not install pulseaudio-utils to fix it — that trades a silent Zoom for one that will not start. Sound in other apps (Chrome, Slack, Teams) is unaffected."},{"bookmarks":[],"id":868821752,"inlineImages":{},"runs":[{"length":12,"style":{}},{"length":3,"style":{"bold":true}},{"length":5,"style":{}},{"length":10,"style":{"bold":true}},{"length":18,"style":{}},{"length":6,"style":{"bold":true}},{"length":129,"style":{}}],"style":{"list":0},"text":"Verified on AMD and virtio-gpu graphics, and on NVIDIA as the second GPU of a hybrid laptop (per-app render offload). Intel, and NVIDIA driving the desktop itself, are not yet tested."},{"bookmarks":[],"id":1357787448,"inlineImages":{},"runs":[{"length":47,"style":{}},{"length":36,"style":{"fontFamily":"Liberation Mono"}},{"length":71,"style":{}}],"style":{},"text":"If something misbehaves, the session log is at /tmp/starling-session-<your-uid>.log, and issues go to <https://github.com/starling-build/starling/issues>."}],"readFromFile":false,"styleAliases":{},"styles":{"styles":[{"char":{"color":4280427042,"complexFontFamily":"Caladea","fontFamily":