{"document":{"addsParagraphSpacing":false,"adjustsLineHeightInTable":false,"backgroundRels":[],"balancesSpaceWidth":false,"compatibilityMode":15,"defaultLangXML":"<w:lang w:val=\"en-US\"/>","defaultTabStop":36,"divMargins":{},"docGridXML":"<w:docGrid w:linePitch=\"360\"/>","endnoteSeparator":[],"endnotes":{},"evenAndOddHeaders":false,"fileFonts":["Courier New","Arial"],"flipsMirrorIndents":true,"footer":"Page {PAGE} of {NUMPAGES}","footnoteSeparator":[],"footnotes":{},"hangsHalf":false,"header":"Starling Desktop  ·  User manual","headerFooters":[{"kind":0,"paragraphs":[{"bookmarks":[],"id":0,"inlineImages":{},"runs":[{"length":32,"style":{}}],"style":{"alignment":2,"borders":{"bottom":{"color":4291876834,"space":4,"width":0.5}},"lineSpacing":1.15,"named":"Header","spaceAfter":0},"text":"Starling Desktop  ·  User manual"}],"section":0,"type":"default"},{"kind":1,"paragraphs":[{"bookmarks":[],"id":0,"inlineImages":{},"runs":[{"length":5,"style":{}},{"length":1,"style":{"field":"PAGE","fieldResult":1}},{"length":4,"style":{}},{"length":1,"style":{"field":"NUMPAGES","fieldResult":2}}],"style":{"alignment":1,"lineSpacing":1.15,"named":"Footer","spaceAfter":0},"text":"Page 1 of 1"}],"section":0,"type":"default"}],"htmlAutoSpacing":true,"indentNotNumberingTabStop":false,"keptCharacterStyleIds":{"hyperlink":"Hyperlink"},"keptCharacterStyles":{"Hyperlink":"<w:style w:styleId=\"Hyperlink\" w:type=\"character\"><w:name w:val=\"Hyperlink\"/><w:qFormat/><w:pPr/><w:rPr><w:color w:val=\"2F5496\"/><w:u w:val=\"single\"/></w:rPr></w:style>"},"keptCompat":"<w:compat><w:compatSetting w:name=\"compatibilityMode\" w:uri=\"http://schemas.microsoft.com/office/word\" w:val=\"15\"/></w:compat>","keptHeaderFooters":[{"kind":0,"part":"word/header1.xml","text":"Starling Desktop  ·  User manual","type":"default"},{"kind":1,"part":"word/footer1.xml","text":"Page {PAGE} of {NUMPAGES}","type":"default"}],"keptPartTypes":{"word/footer1.xml":"application/vnd.openxmlformats-officedocument.wordprocessingml.footer+xml","word/header1.xml":"application/vnd.openxmlformats-officedocument.wordprocessingml.header+xml"},"keptParts":{"word/footer1.xml":"","word/header1.xml":""},"keptSettings":{},"keptTables":{},"kernsPunctuation":true,"listCounterOf":{},"listFormats":{},"listRestarts":{},"paragraphs":[{"bookmarks":[],"id":1147662393,"inlineImages":{},"runs":[{"length":15,"style":{}}],"style":{"heading":1},"text":"The screensaver"},{"bookmarks":[],"id":938375191,"inlineImages":{},"runs":[{"length":298,"style":{}},{"length":16,"style":{"bold":true}},{"length":22,"style":{}}],"style":{},"text":"Leave the desk for ten minutes and the desktop dissolves into a screensaver: your own screen, blurred and drifting behind a slow liquid warp, with the time and date floating over it. Any key, click, or mouse movement brings it straight back — nothing is asked for, so it is decoration, not a lock. Ctrl + Shift + S shows it immediately."},{"bookmarks":[],"id":1213794073,"inlineImages":{},"runs":[{"length":41,"style":{}},{"length":35,"style":{"bold":true}},{"length":241,"style":{}}],"style":{},"text":"Change the idle time (or turn it off) in Settings → Appearance → Screensaver. Video playback holds it off: an app that tells the desktop it is playing something — Chrome, Firefox, a video player — keeps the screensaver away for as long as it says so, so a film watched without touching the mouse is never interrupted."},{"bookmarks":[],"id":803733824,"inlineImages":{},"runs":[{"length":4,"style":{}},{"length":14,"style":{"bold":true}},{"length":44,"style":{}},{"length":32,"style":{"fontFamily":"Liberation Mono"}},{"length":231,"style":{}}],"style":{},"text":"For aerial footage in place of the warp, drop a video file in ~/.local/share/starling/aerials/; the screensaver dissolves into it and loops it. Starling ships none of its own — the warp needs no assets, and the clips worth watching are large. Any shape works: letterbox bars are cropped away and the picture fills the screen."}],"readFromF