{"document":{"addsParagraphSpacing":false,"adjustsLineHeightInTable":true,"backgroundRels":[],"balancesSpaceWidth":false,"divMargins":{},"endnoteSeparator":[],"endnotes":{},"evenAndOddHeaders":false,"fileFonts":[],"flipsMirrorIndents":true,"footer":"","footnoteSeparator":[],"footnotes":{},"hangsHalf":false,"header":"","headerFooters":[],"htmlAutoSpacing":true,"keptCharacterStyleIds":{},"keptCharacterStyles":{},"keptHeaderFooters":[],"keptPartTypes":{},"keptParts":{},"keptSettings":{},"keptTables":{},"kernsPunctuation":true,"listCounterOf":{},"listFormats":{},"listRestarts":{},"paragraphs":[{"bookmarks":[],"id":671396925,"inlineImages":{},"runs":[{"length":32,"style":{}}],"style":{"heading":1},"text":"Publish documents, not web pages"},{"bookmarks":[],"id":1730859194,"inlineImages":{},"runs":[{"length":164,"style":{}}],"style":{},"text":"Every page on this site is a Word document, stored in a git repository and drawn here by Starling Writer. Nothing is converted to HTML. What you see is what prints."},{"bookmarks":[],"id":497225022,"inlineImages":{},"runs":[{"length":41,"style":{}}],"style":{"heading":2},"text":"What a page can do that a web page cannot"},{"bookmarks":[],"id":1798517192,"inlineImages":{},"runs":[{"length":104,"style":{}}],"style":{"list":0},"text":"Real pages, with headers, footers and page numbers, on a desktop; the same document reflowed on a phone."},{"bookmarks":[],"id":1281321788,"inlineImages":{},"runs":[{"length":82,"style":{}}],"style":{"list":0},"text":"A table of contents whose entries carry page numbers, and a link to any paragraph."},{"bookmarks":[],"id":522913136,"inlineImages":{},"runs":[{"length":87,"style":{}}],"style":{"list":0},"text":"Tables that run across pages, footnotes at the foot of the page, Word's own typography."},{"bookmarks":[],"id":1850163232,"inlineImages":{},"runs":[{"length":75,"style":{}}],"style":{"list":0},"text":"A PDF that is the same painter: the pages you read are the pages you print."},{"bookmarks":[],"id":768854968,"inlineImages":{},"runs":[{"length":14,"style":{}}],"style":{"heading":2},"text":"How it is made"},{"bookmarks":[],"id":549698338,"inlineImages":{},"runs":[{"length":211,"style":{}}],"style":{},"text":"Authors edit in Starling Writer, with its full ribbon, on a clone of the repository. Publish builds this folder, commits and pushes; GitHub Pages serves it. There is no server, no sign-in and no build toolchain."},{"bookmarks":[],"id":408723890,"inlineImages":{},"runs":[{"length":189,"style":{}}],"style":{},"text":"Open \"Published documents\" for three real documents: a 24-page security policy with footnotes and two NIST documents, one with 81 headings and a table of contents, one with 778 table cells."}],"readFromFile":false,"styleAliases":{},"styles":{"styles":[{"char":{},"id":"Normal","name":"Normal","paragraph":{}},{"char":{"color":4280236132,"fontSize":28},"id":"Title","name":"Title","next":"Normal","paragraph":{"lineSpacing":1,"spaceAfter":4}},{"char":{"color":4284111450,"fontSize":13},"id":"Subtitle","name":"Subtitle","next":"Normal","paragraph":{}},{"char":{"bold":true,"color":4281291926,"fontSize":20},"id":"Heading1","name":"Heading 1","next":"Normal","paragraph":{"heading":1,"spaceAfter":4,"spaceBefore":12}},{"char":{"bold":true,"color":4281291926,"fontSize":16},"id":"Heading2","name":"Heading 2","next":"Normal","paragraph":{"heading":2,"spaceAfter":4,"spaceBefore":8}},{"char":{"bold":true,"color":4281291926,"fontSize":14},"id":"Heading3","name":"Heading 3","next":"Normal","paragraph":{"heading":3,"spaceAfter":4,"spaceBefore":8}},{"char":{"bold":true,"color":4281291926,"fontSize":12,"italic":true},"id":"Heading4","name":"Heading 4","next":"Normal","paragraph":{"heading":4,"spaceAfter":2,"spaceBefore":4}},{"char":{"color":4281291926,"fontSize":11},"id":"Heading5","name":"Heading 5","next":"Normal","paragraph":{"heading":5,"spaceAfter":2,"spaceBefore":4}},{"char":{"color":4281291926,"fontSize":11,"italic":true},"id":"Heading6","name":"Heading 6","next