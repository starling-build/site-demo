{"document":{"addsParagraphSpacing":false,"adjustsLineHeightInTable":false,"backgroundRels":[],"balancesSpaceWidth":false,"compatibilityMode":15,"defaultLangXML":"<w:lang w:val=\"en-US\"/>","defaultTabStop":36,"divMargins":{},"docGridXML":"<w:docGrid w:linePitch=\"360\"/>","endnoteSeparator":[],"endnotes":{},"evenAndOddHeaders":false,"fileFonts":["Caladea","Liberation Mono","Libre Franklin"],"flipsMirrorIndents":true,"footer":"Page {PAGE} of {NUMPAGES}","footnoteSeparator":[],"footnotes":{},"hangsHalf":false,"header":"Starling Desktop  ·  User manual","headerFooters":[{"kind":0,"paragraphs":[{"bookmarks":[],"id":0,"inlineImages":{},"runs":[{"length":32,"style":{}}],"style":{"alignment":2,"borders":{"bottom":{"color":4291876834,"space":4,"width":0.5}},"lineSpacing":1.1708333333333334,"named":"Header","spaceAfter":0},"text":"Starling Desktop  ·  User manual"}],"section":0,"type":"default"},{"kind":1,"paragraphs":[{"bookmarks":[],"id":0,"inlineImages":{},"runs":[{"length":5,"style":{}},{"length":1,"style":{"field":"PAGE","fieldResult":1}},{"length":4,"style":{}},{"length":1,"style":{"field":"NUMPAGES","fieldResult":2}}],"style":{"alignment":1,"lineSpacing":1.1708333333333334,"named":"Footer","spaceAfter":0},"text":"Page 1 of 1"}],"section":0,"type":"default"}],"htmlAutoSpacing":true,"indentNotNumberingTabStop":false,"keptCharacterStyleIds":{"hyperlink":"Hyperlink"},"keptCharacterStyles":{"Hyperlink":"<w:style w:styleId=\"Hyperlink\" w:type=\"character\"><w:name w:val=\"Hyperlink\"/><w:qFormat/><w:pPr/><w:rPr><w:color w:val=\"C8102E\"/><w:u w:val=\"single\"/></w:rPr></w:style>"},"keptCompat":"<w:compat><w:compatSetting w:name=\"compatibilityMode\" w:uri=\"http://schemas.microsoft.com/office/word\" w:val=\"15\"/></w:compat>","keptHeaderFooters":[{"kind":0,"part":"word/header1.xml","text":"Starling Desktop  ·  User manual","type":"default"},{"kind":1,"part":"word/footer1.xml","text":"Page {PAGE} of {NUMPAGES}","type":"default"}],"keptPartTypes":{"word/footer1.xml":"application/vnd.openxmlformats-officedocument.wordprocessingml.footer+xml","word/header1.xml":"application/vnd.openxmlformats-officedocument.wordprocessingml.header+xml"},"keptParts":{"word/footer1.xml":"","word/header1.xml":""},"keptSettings":{},"keptTables":{},"kernsPunctuation":true,"listCounterOf":{},"listFormats":{},"listRestarts":{},"paragraphs":[{"bookmarks":[],"id":1564419560,"inlineImages":{},"runs":[{"length":20,"style":{}}],"style":{"borders":{"bottom":{"color":4291301422,"space":6,"width":1.5}},"heading":1,"keepLines":true,"keepNext":true,"lineSpacing":1.1708333333333334,"spaceAfter":10,"spaceBefore":28},"text":"Installing more apps"},{"bookmarks":[],"id":1864671435,"inlineImages":{},"runs":[{"length":114,"style":{}}],"style":{},"text":"Starling launches applications that are installed on your machine — it does not bundle them. Two ways to add them:"},{"bookmarks":[],"id":1145376815,"inlineImages":{},"runs":[{"length":21,"style":{}}],"style":{"heading":3,"keepLines":true,"keepNext":true,"lineSpacing":1.1708333333333334,"spaceAfter":4,"spaceBefore":14},"text":"Through the App Store"},{"bookmarks":[],"id":169812688,"inlineImages":{},"runs":[{"length":9,"style":{}},{"length":9,"style":{"bold":true}},{"length":168,"style":{}},{"length":7,"style":{"bold":true}},{"length":57,"style":{}},{"length":3,"style":{"fontFamily":"Liberation Mono"}},{"length":45,"style":{}},{"length":6,"style":{"fontFamily":"Liberation Mono"}},{"length":108,"style":{}}],"style":{},"text":"Open the App Store from the dock. It lists a curated set of applications — Chrome, VS Code, Slack, Discord, Teams, Telegram, IntelliJ IDEA, GIMP, Blender, Spotify, Zoom, and more. Click Install on one and Starling installs it using your system's own apt (you may be asked to authenticate — this is polkit authorising the install). When it finishes, the app appears in the Launchpad and can be pinned to the dock."},{"bookmarks":[],"id":1777680988,"inlineImages":{},"runs":[{"length":53,"style":{}}],"style":{},"text":"A few things to know about the store in this release:"},{"bookmarks":[],"id":1222838866,"inlineImages":{},"runs":[{"length":15,"style":{}},{"length":17,"style":{"bold":true}},{"length":80,"style":{}}],"style":{"list":0},"text":"The catalog is small and curated — every entry installs and launches, but it is not your whole software library."},{"bookmarks":[],"id":1043951795,"inlineImages":{},"runs":[{"length":10,"style":{}},{"length":23,"style":{"bold":true}},{"length":225,"style":{}}],"style":{"list":0},"text":"Tiles use generic category glyphs, not vendor logos, on purpose — those logos are trademarks and Starling ships none of them. Chrome and VS Code show their real icons in the Launchpad and dock (read from your system at runtime); the rest use a neutral glyph."},{"bookmarks":[],"id":260900277,"inlineImages":{},"runs":[{"length":34,"style":{}}],"style":{"heading":3,"keepLines":true,"keepNext":true,"lineSpacing":1.1708333333333334,"spaceAfter":4,"spaceBefore":14},"text":"With your distribution's packaging"},{"bookmarks":[],"id":930624841,"inlineImages":{},"runs":[{"length":38,"style":{}},{"length":26,"style":{"fontFamily":"Liberation Mono"}},{"length":4,"style":{}},{"length":4,"style":{"fontFamily":"Liberation Mono"}},{"length":212,"style":{}}],"style":{},"text":"Anything you install the normal way — sudo apt install <package>, a .deb, a Snap or Flatpak — is a native Linux app, and Starling will run it as a Wayland client (or through the in-tree X server for X11 apps). The major toolkits composite today: Chromium/Electron, Qt6, GTK3 and GTK4."}],"readFromFile":false,"styleAliases":{},"styles":{"styles":[{"char":{"color":4280427042,"complexFontFamily":"Caladea","fontFamily":"Caladea","fontSize":11.5,"keptXML":"<w:lang w:val=\"en-US\"/>"},"id":"Normal","name":"Normal","paragraph":{"lineSpacing":1.1708333333333334,"spaceAfter":8.05}},{"char":{"bold":true,"color":4279188812,"complexFontFamily":"Libre Franklin","fontFamily":"Libre Franklin","fontSize":40},"id":"Ti