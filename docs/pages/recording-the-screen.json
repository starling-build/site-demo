{"document":{"addsParagraphSpacing":false,"adjustsLineHeightInTable":false,"backgroundRels":[],"balancesSpaceWidth":false,"compatibilityMode":15,"defaultLangXML":"<w:lang w:val=\"en-US\"/>","defaultTabStop":36,"divMargins":{},"docGridXML":"<w:docGrid w:linePitch=\"360\"/>","endnoteSeparator":[],"endnotes":{},"evenAndOddHeaders":false,"fileFonts":["Arial","Courier New"],"flipsMirrorIndents":true,"footer":"Page {PAGE} of {NUMPAGES}","footnoteSeparator":[],"footnotes":{},"hangsHalf":false,"header":"Starling Desktop  ·  User manual","headerFooters":[{"kind":0,"paragraphs":[{"bookmarks":[],"id":0,"inlineImages":{},"runs":[{"length":32,"style":{}}],"style":{"alignment":2,"borders":{"bottom":{"color":4291876834,"space":4,"width":0.5}},"lineSpacing":1.15,"named":"Header","spaceAfter":0},"text":"Starling Desktop  ·  User manual"}],"section":0,"type":"default"},{"kind":1,"paragraphs":[{"bookmarks":[],"id":0,"inlineImages":{},"runs":[{"length":5,"style":{}},{"length":1,"style":{"field":"PAGE","fieldResult":1}},{"length":4,"style":{}},{"length":1,"style":{"field":"NUMPAGES","fieldResult":2}}],"style":{"alignment":1,"lineSpacing":1.15,"named":"Footer","spaceAfter":0},"text":"Page 1 of 1"}],"section":0,"type":"default"}],"htmlAutoSpacing":true,"indentNotNumberingTabStop":false,"keptCharacterStyleIds":{"hyperlink":"Hyperlink"},"keptCharacterStyles":{"Hyperlink":"<w:style w:styleId=\"Hyperlink\" w:type=\"character\"><w:name w:val=\"Hyperlink\"/><w:qFormat/><w:pPr/><w:rPr><w:color w:val=\"2F5496\"/><w:u w:val=\"single\"/></w:rPr></w:style>"},"keptCompat":"<w:compat><w:compatSetting w:name=\"compatibilityMode\" w:uri=\"http://schemas.microsoft.com/office/word\" w:val=\"15\"/></w:compat>","keptHeaderFooters":[{"kind":0,"part":"word/header1.xml","text":"Starling Desktop  ·  User manual","type":"default"},{"kind":1,"part":"word/footer1.xml","text":"Page {PAGE} of {NUMPAGES}","type":"default"}],"keptPartTypes":{"word/footer1.xml":"application/vnd.openxmlformats-officedocument.wordprocessingml.footer+xml","word/header1.xml":"application/vnd.openxmlformats-officedocument.wordprocessingml.header+xml"},"keptParts":{"word/footer1.xml":"","word/header1.xml":""},"keptSettings":{},"keptTables":{},"kernsPunctuation":true,"listCounterOf":{},"listFormats":{},"listRestarts":{},"paragraphs":[{"bookmarks":[],"id":1243938417,"inlineImages":{},"runs":[{"length":20,"style":{}}],"style":{"heading":1},"text":"Recording the screen"},{"bookmarks":[],"id":451857641,"inlineImages":{},"runs":[{"length":48,"style":{}}],"style":{},"text":"Starling records itself, with no extra software."},{"bookmarks":[],"id":919986898,"inlineImages":{},"runs":[{"length":6,"style":{"bold":true}},{"length":21,"style":{}},{"length":16,"style":{"bold":true}},{"length":28,"style":{}}],"style":{"list":0},"text":"Record (control centre, or Ctrl + Shift + R) captures the whole screen."},{"bookmarks":[],"id":2041717268,"inlineImages":{},"runs":[{"length":10,"style":{"bold":true}},{"length":289,"style":{}}],"style":{"list":0},"text":"Record App opens Mission Control and asks which window you want. It captures that window's own content, not the region of screen it sits in, so windows stacked on top never appear and moving or resizing the window mid-recording doesn't spoil the take. The pointer is drawn in and follows the window."},{"bookmarks":[],"id":1510836297,"inlineImages":{},"runs":[{"length":26,"style":{}},{"length":27,"style":{"bold":true}},{"length":103,"style":{}}],"style":{},"text":"While a recording runs, a red dot and a running clock sit in the menu bar, so a recording can never be going unnoticed. Stop it the same way you started it."},{"bookmarks":[],"id":961308936,"inlineImages":{},"runs":[{"length":19,"style":{}},{"length":8,"style":{"bold":true,"fontFamily":"Liberation Mono"}},{"length":330,"style":{}}],"style":{},"text":"Recordings land in ~/Videos as MP4, and the Video Player opens them. Where the machine has a hardware H.264 encoder, the frame the compositor already drew goes straight to it as a dma-buf and the CPU never touches a pixel — on a modern laptop that costs about 0.05 of a core. Machines without one fall back to a software encoder, which works but costs more."}],"readFromFile":false,"styleAliases":{},"styles":{"styles":[{"char":{"color":4280230696,"complexFontFamily":"Arial","fontFamily":"Arial","fontSize":11,"keptXML":"<w:lang w:val=\"en-US\"/>"},"id":"Normal","name":"Normal","paragraph":{"lineSpacing":1.15}},{"char":{"bold":true,"color":4280232516,"fontSize":36,"letterSpacing":-0.5},"id":"Title","name":"Title","next":"Normal","paragraph":{"contextualSpacing":true,"lineSpacing":1.15,"spaceAfter":6,"spaceBefore":120}},{"char":{"color":4285231744,"fontSize":16},"id":"Subtitle","name":"Subtitle","next":"Normal","paragraph":{"lineSpacing":1.15,"spaceAfter":24}},{"char":{"bold":true,"color":4280232516,"fontSize":20},"id":"Heading1","name":"Heading 1","next":"Normal","paragraph":{"borders":{"bottom":{"color":4291876834,"space":4,"width":0.75}},"heading":1,"keepLines":true,"keepNext":true,"lineSpacing":1.15,"spaceBefore":24}},{"char":{"bold":true,"color":4281291926,"fontSize":14},"id":"Heading2","name":"Heading 2","next":"Normal","paragraph":{"heading":2,"keepLines":true,"keepNext":true,"lineSpacing":1.15,"spaceAfter":6,"spaceBefore":18}},{"char":{"bold":true,"color":4280230696,"fontSize":12},"id":"Heading3","name":"Heading 3","next":"Normal","paragraph":{"heading":3,"keepLines":true,"keepNext":true,"lineSpacing":1.15,"spaceAfter":4,"spaceBefore":12}},{"char":{"bold":true,"color":4281291926,"fontSize":12,"italic":true},"id":"Heading4","name":"Heading 4","next":"Normal","paragraph":{"heading":4,"spaceAfter":2,"spaceBefore":4}},{"char":{"color":4281291926,"fontSize":11},"id":"Heading5","name":"Heading 5","next":"Normal","paragraph":{"heading":5,"spaceAfter":2,"spaceBefore":4}},{"char":{"color":4281291926,"fontSize":11,"italic":true},"id":"Heading6","name":"Heading 6","next":"Normal","paragraph":{"heading":6,"spaceAfter":2,"spaceBefore":4}